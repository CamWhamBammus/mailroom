# Copy this file to .env.local and fill in the values from your Google Cloud
# OAuth client (see the setup steps you were given). .env.local is gitignored.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match the "Authorized redirect URI" you set on the OAuth
# client in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3003/api/auth/callback
